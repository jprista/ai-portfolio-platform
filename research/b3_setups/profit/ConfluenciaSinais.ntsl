//======================================================================
//  CONFLUENCIA B3 - SINAIS
//  Indicador de ENTRADA para o Profit (NTSL) - aplique SOBRE o grafico
//----------------------------------------------------------------------
//  Mostra ONDE comprar e ONDE vender, com os tres precos na tela:
//  entrada, stop e alvo. O alvo e sempre 2,5x o risco realmente assumido.
//
//  O STOP E ESTRUTURAL, nao um multiplo fixo de ATR: fica na minima das
//  ultimas N barras (compra) ou na maxima (venda), um tick alem. Esse e o
//  menor stop que o grafico justifica - abaixo dele o motivo do trade
//  deixou de existir.
//
//  SairPorConfluencia VEM DESLIGADO POR MEDICAO. Quando ligado, a posicao
//  saia antes de 1R ou do stop resolverem - pagando o custo inteiro por um
//  trade que nunca chegou a ser decidido. Desligar levou as posicoes no verde
//  de 41,5% para 48,3% e a sangria de -4,79 para -4,06 por posicao.
//
//  DUAS COISAS QUE MUDARAM DEPOIS DE MEDIR, e que atacam a queixa de
//  "esta dando mais stop do que gain":
//
//  1) O STOP PRECISA COBRIR 1 ATR. Com stop fixo e apertado, 80% dos trades
//     fechavam na MESMA barra em que abriram - eram estopados pelo ruido de
//     um unico candle, nao por a direcao estar errada. StopMinimoATR resolve
//     isso e se adapta sozinho ao tempo grafico e ao dia.
//
//  2) ZERO A ZERO EM 1R. Ao andar 1R a favor, o stop vai para a entrada. Nao
//     cria vantagem nenhuma - move resultado da coluna de perda para a de
//     empate. Medido: posicoes que nao terminam no vermelho vao de 31% para
//     44%, e a sangria por posicao cai de -1,64 para -0,06.
//
//  MAIS STOP DO QUE GAIN E O DESENHO, NAO O DEFEITO. Com alvo de 2,5R a
//  geometria entrega no maximo 28,6% de acerto - ou seja, ~71% de stops e o
//  esperado. Quem quiser taxa de acerto alta precisa baixar o alvo, e ai o
//  payoff cai junto. Medido nesta mesma base:
//
//      alvo 2,5R  ->  acerto 22,6% + 21,9% no zero  ->  payoff 2,51
//      alvo 1,0R  ->  acerto 53,8%                  ->  payoff 0,64
//
//  O segundo "acerta" mais que o dobro e perde 50x mais dinheiro. Taxa de
//  acerto se compra; o preco e a expectativa.
//
//  E a aritmetica do custo continua valendo: a ida e volta custa ~11 pontos
//  no WIN, FIXO, e o acerto necessario e (R + 11) / (3,5 x R):
//
//      risco 250 pts -> precisa 29,8%      risco  50 pts -> precisa 35,0%
//      risco 100 pts -> precisa 31,7%      risco  20 pts -> precisa 44,4%
//======================================================================

input
  //--- placar (identicos ao ConfluenciaB3)
  PerRapida(9);
  PerMedia(21);
  PerLenta(50);
  PesoTendencia(30);
  PesoVWAP(25);
  PerDI(14);
  PerADX(14);
  ADXMinimo(20);
  ADXPleno(40);
  PesoForca(20);
  PerIFR(14);
  IFRAlto(70);
  IFRBaixo(30);
  PesoIFR(15);
  PerVolume(20);
  PesoVolume(10);
  Limiar(45);

  //--- gate de custo
  PerATR(14);
  CustoPontosIdaVolta(11);
  MultiploMinimoATR(4);
  UsarGateCusto(1);

  //--- geometria do trade
  SwingBarras(5);        // quantas barras definem o stop estrutural
  StopMinimoATR(1.0);    // o stop TEM de cobrir pelo menos 1 ATR - ver nota
  RiscoMinTicks(2);      // piso absoluto em ticks
  RiscoMaxTicks(60);     // teto de risco (controle de perda, nao aperto)
  AlvoEmR(2.0);          // alvo = no minimo 2x o risco
  ParcialEmR(1.0);       // realiza metade ao andar 1R a favor
  ZeroAZeroEmR(1.0);     // e no mesmo ponto o stop vai para a entrada
  SairPorConfluencia(0); // 0 = nao sair antes de 1R/stop. Ver nota.
  TamanhoTick(5);        // WIN = 5 pontos. WDO = 0.5
  PermitirVenda(1);

var
  mmr, mmm, mml   : Float;
  fezParcial      : Boolean;
  nivelParcial    : Float;
  zerouRisco      : Boolean;
  nivelZeroAZero  : Float;
  riscoInicial    : Float;
  tp, somaPV, somaV, vwap : Float;
  atrAtual, adxAtual, diMais, diMenos, ifrAtual, volMedia : Float;
  sTend, sVwap, sForca, dist, placar : Float;
  gateOK          : Boolean;
  cruzouCompra    : Boolean;
  cruzouVenda     : Boolean;
  emOperacao      : Float;
  lado            : Float;
  pEntrada        : Float;
  pStop           : Float;
  pAlvo           : Float;
  risco           : Float;
  riscoTicks      : Float;
  swingMin        : Float;
  swingMax        : Float;
  k               : Integer;
  corBarra        : Integer;
  sinalCompra     : Boolean;
  sinalVenda      : Boolean;

begin

  //================================================================
  // 1. VWAP da sessao
  //================================================================
  if (Date <> Date[1]) then
  begin
    somaPV := 0;
    somaV  := 0;
    // um trade nao atravessa o pregao
    emOperacao := 0;
  end;

  tp     := (High + Low + Close) / 3;
  somaPV := somaPV + (tp * Volume);
  somaV  := somaV + Volume;
  if (somaV > 0) then vwap := somaPV / somaV else vwap := tp;

  //================================================================
  // 2. Placar - identico ao ConfluenciaB3
  //================================================================
  mmr      := MediaExp(PerRapida, Close);
  mmm      := MediaExp(PerMedia, Close);
  mml      := MediaExp(PerLenta, Close);
  atrAtual := ATR(PerATR);
  adxAtual := ADX(PerDI, PerADX);
  diMais   := DIpos(PerDI);
  diMenos  := DIneg(PerDI);
  ifrAtual := IFR(PerIFR, Close);
  volMedia := Media(PerVolume, Volume);

  sTend := 0;
  if (mmr > mmm) then sTend := sTend + 0.4;
  if (mmr < mmm) then sTend := sTend - 0.4;
  if (mmm > mml) then sTend := sTend + 0.3;
  if (mmm < mml) then sTend := sTend - 0.3;
  if (mmr > mmr[1]) then sTend := sTend + 0.3;
  if (mmr < mmr[1]) then sTend := sTend - 0.3;

  if (atrAtual > 0) then dist := (Close - vwap) / atrAtual else dist := 0;
  sVwap := dist;
  if (sVwap > 1) then sVwap := 1;
  if (sVwap < -1) then sVwap := -1;

  sForca := 0;
  if (adxAtual > ADXMinimo) and (ADXPleno > ADXMinimo) then
  begin
    sForca := (adxAtual - ADXMinimo) / (ADXPleno - ADXMinimo);
    if (sForca > 1) then sForca := 1;
    if (diMenos > diMais) then sForca := -sForca;
  end;

  placar := (PesoTendencia * sTend) + (PesoVWAP * sVwap) + (PesoForca * sForca);

  if (placar > 0) then
  begin
    if (ifrAtual > IFRAlto) then placar := placar - PesoIFR;
    if (Volume > volMedia) then placar := placar + PesoVolume;
  end;
  if (placar < 0) then
  begin
    if (ifrAtual < IFRBaixo) then placar := placar + PesoIFR;
    if (Volume > volMedia) then placar := placar - PesoVolume;
  end;

  gateOK := True;
  if (UsarGateCusto = 1) and (atrAtual < MultiploMinimoATR * CustoPontosIdaVolta) then
    gateOK := False;

  //================================================================
  // 3. Gestao do trade aberto - ANTES de procurar entrada nova.
  //    Um trade que morreu nesta barra nao abre outro nela.
  //================================================================
  sinalCompra := False;
  sinalVenda  := False;

  if (emOperacao = 1) then
  begin
    if (lado = 1) then
    begin
      if (Low <= pStop) then emOperacao := 0
      else
      begin
        // zero a zero: so depois de descartar o stop nesta barra. A ordem
        // dentro da barra e desconhecida, e supor que o lado bom veio antes
        // e a suposicao otimista que este codigo recusa em todo lugar.
        if (ParcialEmR > 0) and (fezParcial = False) and (High >= nivelParcial) then
          fezParcial := True;
        if (ZeroAZeroEmR > 0) and (zerouRisco = False) and (High >= nivelZeroAZero) then
        begin
          pStop := pEntrada;
          zerouRisco := True;
        end;
        if (High >= pAlvo) then emOperacao := 0
        else if (SairPorConfluencia = 1) and (placar < Limiar / 2) then emOperacao := 0;
      end;
    end
    else
    begin
      if (High >= pStop) then emOperacao := 0
      else
      begin
        if (ParcialEmR > 0) and (fezParcial = False) and (Low <= nivelParcial) then
          fezParcial := True;
        if (ZeroAZeroEmR > 0) and (zerouRisco = False) and (Low <= nivelZeroAZero) then
        begin
          pStop := pEntrada;
          zerouRisco := True;
        end;
        if (Low <= pAlvo) then emOperacao := 0
        else if (SairPorConfluencia = 1) and (placar > -Limiar / 2) then emOperacao := 0;
      end;
    end;
  end
  else
  begin
    //==============================================================
    // 4. Procura de entrada: CRUZAMENTO do limiar, nao permanencia.
    //    Entrar num limiar que ja dura vinte barras e entrar tarde.
    //==============================================================
    cruzouCompra := (placar >= Limiar) and (placar[1] < Limiar);
    cruzouVenda  := (placar <= -Limiar) and (placar[1] > -Limiar);

    if (gateOK = True) and (cruzouCompra or cruzouVenda) then
    begin
      // stop estrutural: extremo das ultimas SwingBarras
      swingMin := Low;
      swingMax := High;
      for k := 0 to SwingBarras - 1 do
      begin
        if (Low[k] < swingMin) then swingMin := Low[k];
        if (High[k] > swingMax) then swingMax := High[k];
      end;

      pEntrada := Close;

      if (cruzouCompra) then
      begin
        pStop := swingMin - TamanhoTick;
        // o stop precisa cobrir o ruido de UMA barra, senao a oscilacao
        // normal de um candle tira o trade antes de a ideia dar errado
        if (pEntrada - pStop < StopMinimoATR * atrAtual) then
          pStop := pEntrada - (StopMinimoATR * atrAtual);
        risco := pEntrada - pStop;
        riscoTicks := risco / TamanhoTick;
        if (riscoTicks < RiscoMinTicks) then riscoTicks := RiscoMinTicks;
        if (riscoTicks > RiscoMaxTicks) then riscoTicks := RiscoMaxTicks;
        risco := riscoTicks * TamanhoTick;
        pStop := pEntrada - risco;
        pAlvo := pEntrada + (AlvoEmR * risco);
        lado  := 1;
        emOperacao := 1;
        sinalCompra := True;
        riscoInicial := risco;
        zerouRisco := False;
        fezParcial := False;
        nivelParcial := pEntrada + (ParcialEmR * risco);
        nivelZeroAZero := pEntrada + (ZeroAZeroEmR * risco);
      end
      else if (PermitirVenda = 1) then
      begin
        pStop := swingMax + TamanhoTick;
        if (pStop - pEntrada < StopMinimoATR * atrAtual) then
          pStop := pEntrada + (StopMinimoATR * atrAtual);
        risco := pStop - pEntrada;
        riscoTicks := risco / TamanhoTick;
        if (riscoTicks < RiscoMinTicks) then riscoTicks := RiscoMinTicks;
        if (riscoTicks > RiscoMaxTicks) then riscoTicks := RiscoMaxTicks;
        risco := riscoTicks * TamanhoTick;
        pStop := pEntrada + risco;
        pAlvo := pEntrada - (AlvoEmR * risco);
        lado  := -1;
        emOperacao := 1;
        sinalVenda := True;
        riscoInicial := risco;
        zerouRisco := False;
        fezParcial := False;
        nivelParcial := pEntrada - (ParcialEmR * risco);
        nivelZeroAZero := pEntrada - (ZeroAZeroEmR * risco);
      end;
    end;
  end;

  //================================================================
  // 5. Plotagem. Fora de operacao os tres niveis colapsam no preco,
  //    entao a tela fica limpa e so "abre" quando existe trade.
  //================================================================
  if (emOperacao = 1) then
  begin
    Plot(pEntrada);
    Plot2(pStop);
    Plot3(pAlvo);
    Plot4(nivelParcial);
  end
  else
  begin
    Plot(Close);
    Plot2(Close);
    Plot3(Close);
    Plot4(Close);
  end;

  SetPlotColor(1, clWhite);
  // stop amarelo depois que foi para o zero a zero: risco ja retirado da mesa
  if (emOperacao = 1) and (zerouRisco = True) then
    SetPlotColor(2, clYellow)
  else
    SetPlotColor(2, clRed);
  SetPlotColor(3, clLime);
  // parcial: ciano antes de realizar, apagado depois
  if (emOperacao = 1) and (fezParcial = False) then
    SetPlotColor(4, clAqua)
  else
    SetPlotColor(4, clGray);

  //--- a barra do sinal fica marcada; enquanto o trade corre, fica suave
  if (sinalCompra) then PaintBar(clLime)
  else if (sinalVenda) then PaintBar(clRed)
  else if (emOperacao = 1) then
  begin
    if (lado = 1) then PaintBar(clGreen) else PaintBar(clMaroon);
  end
  else if (gateOK = False) then PaintBar(clSilver);

end;

//======================================================================
//  COMO LER
//
//  Barra VERDE FORTE   sinal de COMPRA nesta barra
//  Barra VERMELHA      sinal de VENDA nesta barra
//  Barra esverdeada    compra em andamento
//  Barra vinho         venda em andamento
//  Barra cinza         ATR nao paga o custo -> nao ha o que operar
//
//  Linha branca        preco de entrada
//  Linha vermelha      stop
//  Linha AMARELA       stop ja no zero a zero - risco fora da mesa
//  Linha ciano         onde sai a PARCIAL (1R). Cinza depois de realizada
//  Linha verde         alvo (2x o risco)
//
//  OPERACAO EM 2 CONTRATOS: metade sai na linha ciano (1R) e no mesmo ponto
//  o stop vai para a entrada. A outra metade corre ate a linha verde (2R).
//  Os tres desfechos possiveis de uma posicao:
//
//      stop antes de 1R        -1,0R
//      1R -> parcial -> zero   +0,5R
//      1R -> parcial -> 2R     +1,5R
//
//  O sinal nasce no FECHAMENTO da barra marcada. A entrada real e na
//  abertura da barra seguinte - e assim que o backtest mede, para nao
//  se dar um preco que nao existia quando a decisao foi tomada.
//
//----------------------------------------------------------------------
//  AJUSTE POR ATIVO
//    WIN: TamanhoTick 5    CustoPontosIdaVolta 11
//    WDO: TamanhoTick 0.5  CustoPontosIdaVolta 2
//
//  SE ALGO NAO COMPILAR
//    Nao consigo compilar NTSL aqui. ATR, ADX, DIpos, DIneg e SetPlotColor
//    sao os nomes que podem variar de versao - confira no autocompletar.
//    O resto (MediaExp, Media, IFR, Plot, PaintBar, Date, High/Low/Close)
//    e basico e estavel.
//
//----------------------------------------------------------------------
//  VALIDE ANTES DE OPERAR
//    python3 run_replay.py --csv SEU_WIN_5min.csv --contract WIN
//
//  Esse comando roda tres coisas: a varredura de tamanho de stop, o
//  walk-forward cronologico e o nulo calibrado por placebo. Se o walk-
//  forward nao for positivo na maioria dos blocos, ou se o placebo devolver
//  p >= 0,05, o que voce tem e um painel bonito - nao uma vantagem.
//======================================================================
